    {
      "id": "claim_d1d6d5a350a646b8aba5f2c696047cac",
      "statement": "The render hot path must not touch the network; its only filesystem I/O beyond $HOME and timezone detection is two segment-gated, degrade-silently cache reads: the opt-in rate-limit sync high-water cache and the update-notice cache. The network update check runs in a detached child, and all cache I/O errors are swallowed so they can never break rendering.",
      "evidence": [
        {
          "resource": "repo://src/render/mod.rs#L31-L37",
          "version": "repo-lines-v1:sha256:e1d788dab60aaa13e4730189fd4ea6d8b3686dd2d693d3fe4f6f0079ead13a79:"
