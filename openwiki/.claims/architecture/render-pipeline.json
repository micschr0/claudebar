    },
    {
      "id": "claim_d42213f35f574f359fad8d51926a2c6d",
      "statement": "RenderCtx carries injected now, home, and tz_offset_seconds, plus the segment-gated update version, so segments never read the system clock, $HOME, or the network themselves; this injection keeps rendering deterministic and makes golden snapshots and the preview stable.",
      "evidence": [
        {
          "resource": "repo://src/segment/mod.rs#L28-L44",
          "version": "repo-lines-v1:sha256:47db31f12d979799feb5ad2d8c375e9f352d530196c5f6d92d28d44837be1fb3:"
        }
