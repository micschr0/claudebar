    {
      "id": "claim_2c90c7ca4fcf46beaa9cfc0f6493c144",
      "statement": "render_auto renders each segment to its own owned string then greedily packs segments across up to max_lines lines so each line fits the terminal width minus wrap_margin; a terminal width of 0 disables wrapping and falls back to a single line, and terminal_width reads $COLUMNS first, then stty size, else 0.",
