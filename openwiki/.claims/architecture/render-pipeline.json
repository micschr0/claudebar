    {
      "id": "claim_660d476ba3ea4a20911455b3f5332978",
      "statement": "render_fixed iterates cfg.segments in order, renders each through its own SegmentWriter, and joins adjacent non-empty segments with the composer's separator to produce exactly one line; it is used whenever layout is not auto.",
      "evidence": [
        {
          "resource": "repo://src/render/mod.rs#L135-L150",
