    {
      "id": "claim_fce3354879fe41fdb6fcedbc211e32e9",
      "statement": "render_line is the single rendering entrypoint shared by the statusline hook/CLI and the TUI preview; there is deliberately no second rendering code path, so the preview can never diverge from hook output.",
