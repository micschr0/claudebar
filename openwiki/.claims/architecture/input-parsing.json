    {
      "id": "claim_5d972441787d4ee5aed849c8b1908548",
      "statement": "Every numeric field in the parsed session JSON is wrapped in Coerce, a forgiving deserializer mirroring jq's `tonumber? // <default>`: a wrong-typed or unparseable value degrades that one field to None instead of aborting the whole parse.",
      "evidence": [
        {
          "resource": "repo://src/model/input.rs#L1-L16",
          "version": "repo-lines-v1:sha256:4105fd1b2e0a7ae625780d169ce5092432ab9a31e4eb8e9f4ab28529b9232e3e:"
        }
      ]
    },
    {
      "id": "claim_537806e882ad4acca758dd73732ee7ec",
      "statement": "InputData::parse runs serde_json::from_str(s).unwrap_or_default(), so even fully invalid JSON returns InputData::default() and the render path always produces a line.",
      "evidence": [
        {
          "resource": "repo://src/model/input.rs#L147-L153",
          "version": "repo-lines-v1:sha256:42531db528c65bd535237aeaf632a6767ba78c12f1d0c6c610ef03114205fdba:"
        }
      ]
    },
    {
