    {
      "id": "claim_7097abdbe70f4177a880a171f4fea17a",
      "statement": "For a stable release, release-prep.yml's git-cliff roll-up spans every commit since the last stable tag (not since the last beta) so intermediate betas aren't dropped; the version's -beta.N suffix must be explicit because release.yml prunes all older prerelease tags, so N can't be derived from the tag list.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/release-prep.yml#L17-L20",
          "version": "repo-lines-v1:sha256:de88f035f9b89c81014375f3ac636095189be98601739b4c9af170389f6d0947:"
