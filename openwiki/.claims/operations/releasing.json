  "claims": [
    {
      "id": "claim_470ab8ae59d04c059b04e09fbc0acbb5",
      "statement": "Cargo.toml [package] version is the single source of truth for the release version; cargo-dist requires the pushed git tag to equal it byte-for-byte and a mismatch fails the release, so the manifest is bumped before tagging.",
      "evidence": [
        {
          "resource": "repo://Cargo.toml#L1-L3",
          "version": "repo-lines-v1:sha256:9c9ded0e3b320b8fad972146a9c1ccee2720a38ffdec03faf7082a3c3d07f0b7:"
        },
        {
          "resource": "repo://RELEASING.md#L19-L25",
          "version": "repo-lines-v1:sha256:5181ec9a787052728a0cca64e04f1b2b142df04145c6b1a8aa277a170c377a63:"
        }
      ]
    },
    {
      "id": "claim_30efffc4876249388f5b2117b776222a",
      "statement": "claudebar uses digit-first CalVer YYYY.M.PATCH with no leading zeros and no 'v' tag prefix; leading zeros are invalid semver that break both Cargo's manifest parse and dist's tag/version match.",
      "evidence": [
        {
          "resource": "repo://RELEASING.md#L27-L35",
          "version": "repo-lines-v1:sha256:1f161212afc6e6b124cfa98f7c481bba0cb80fa6abe6187efaf80c10fe7a1c51:"
        },
        {
          "resource": "repo://cliff.toml#L55-L55",
          "version": "repo-lines-v1:sha256:70037405561e97610f02d87d94a78ad3e45c39d9fe691c2fb8be563e8e5ef943:"
        }
      ]
    },
    {
      "id": "claim_3422207fe3ab413b95d5d0940e731b3d",
      "statement": "The release.yml tag trigger glob '**[0-9]+.[0-9]+.[0-9]+*' matches the digit-first, no-v-prefix CalVer tag.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/release.yml#L15-L19",
          "version": "repo-lines-v1:sha256:2c6855e21fb7c06f1fc16507af26d5eec9b09ef94d98ea924fb218595f15ed43:"
