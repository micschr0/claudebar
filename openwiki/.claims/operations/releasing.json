    {
      "id": "claim_bbd95e35f74c4a849d8b55183fe05c06",
      "statement": "A manual fallback is documented for cutting a release: bump Cargo.toml, sync Cargo.lock with a cargo command (a stale lockfile fails dist's locked build), splice a git-cliff --unreleased --tag <ver> --strip all section below the <!-- next-release --> marker, tag the byte-exact version, and push both commit and tag; a bare git push of the version bump to main is enough to cut a release because the tag job fires on it.",
      "evidence": [
        {
          "resource": "repo://RELEASING.md#L72-L118",
          "version": "repo-lines-v1:sha256:8b538ceb90344580b9465f3a83d06d1767af382b763c011c1f3543e2919fa312:"
        }
      ]
    },
    {
