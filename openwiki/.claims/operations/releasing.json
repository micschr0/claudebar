    {
      "id": "claim_67843e421bbb4c63b18faf5ac6a6e16e",
      "statement": "The cargo-dist config in [workspace.metadata.dist] sets auditable = true (embedding dependency metadata for cargo audit bin scanning), checksum = \"sha256\", installers = [\"homebrew\"] as the only dist-built installer (install.sh ships independently from the repo root), publish-prereleases = true (letting beta tags drive the Homebrew job into the @beta branch), and allow-dirty = [\"ci\"] to accept the hand-edited (action-SHA-pinned) release.yml divergence from what dist generates.",
      "evidence": [
