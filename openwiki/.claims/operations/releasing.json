    {
      "id": "claim_bedc093fc597473d8b3a88296d6b4061",
      "statement": "release-prep.yml's tag job fires on any push to main touching Cargo.toml, reads the version from the manifest, and pushes the matching git tag with the GitHub App token because a tag created with GITHUB_TOKEN would not trigger release.yml; if the tag already exists it is a no-op.",
      "evidence": [
