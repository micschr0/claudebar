    {
      "id": "claim_b8342a021a924b25806fff21dfb1ec7b",
      "statement": "release-prep.yml's prepare job (manual dispatch, default version is today's CalVer) opens a chore(release): <version> PR containing exactly three files: the Cargo.toml version bump, the Cargo.lock synced via cargo metadata, and a git-cliff-generated CHANGELOG.md section spliced below the <!-- next-release --> marker, while validating the version against the CalVer regex and rejecting existing tags.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/release-prep.yml#L34-L131",
          "version": "repo-lines-v1:sha256:f58267898a6c2bb184fd86e131fac2d1e0ea866e3499107df5e8c6d8ce70c306:"
