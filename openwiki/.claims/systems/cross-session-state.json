    {
      "id": "claim_8e259425333a4effa86c64c5c56382fb",
      "statement": "limit_sync shares the high-water mark across sessions on a host so idle sessions reflect other sessions' usage; it is opt-in, gated by thresholds.limit_sync which defaults to false.",
      "evidence": [
        {
          "resource": "repo://src/model/config.rs#L127-L128",
          "version": "repo-lines-v1:sha256:4e444fe95b84899e233ff254dedaa24f9f23e344be6a6dc091754c7d9d20759c:"
