          "version": "repo-lines-v1:sha256:ac9fafac9480b24a7c0a93c7a18185981d28268adfadb0060630dc0fbb4a5348:"
        }
      ]
    },
    {
      "id": "claim_c87aeb09a4104b01bd1084edb1a863d9",
      "statement": "limit_sync record_* rejects implausible data rather than storing it: non-finite or out-of-range pct, and resets_at more than 6 hours ahead for the 5-hour window or 8 days ahead for the 7-day window (corrupt/sentinel values dropped).",
      "evidence": [
        {
          "resource": "repo://src/segment/limit_sync.rs#L41-L44",
          "version": "repo-lines-v1:sha256:8f077ef53ca3efc33b5f86bc02f7148a3de132c812b6098506f85b13fa387099:"
