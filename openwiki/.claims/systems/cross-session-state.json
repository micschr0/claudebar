    },
    {
      "id": "claim_6fc8314ffd0b4353babd51bee33b17e3",
      "statement": "The burn segment appends a (now, pct, resets_at) sample to a TSV cache at $XDG_CACHE_HOME/claudebar/burn-5h.tsv (else ~/.cache/claudebar), overridable via CLAUDEBAR_BURN_FILE for tests; rows are capped at MAX_ROWS (1500) via an append-then-trim that keeps only the last MAX_ROWS lines.",
      "evidence": [
        {
          "resource": "repo://src/segment/burn.rs#L289-L309",
