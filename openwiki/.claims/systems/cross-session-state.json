    {
      "id": "claim_c6048c19a6704508b6e295c353dd6f1b",
      "statement": "The float is written atomically by write_atomic: it creates parent dirs, writes to a sibling temp file named .{name}.{pid}.tmp (pid-tagged so concurrent writers do not clobber each other's staging files), then renames over the target, which is atomic on POSIX; any I/O error is silently swallowed.",
      "evidence": [
        {
          "resource": "repo://src/render/float.rs#L125-L152",
          "version": "repo-lines-v1:sha256:19ab0ac497ea94895fd5d693cc09b0f558ccb1aec85ccd533c0f9fe968fb1374:"
        }
      ]
