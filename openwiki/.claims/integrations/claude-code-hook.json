    {
      "id": "claim_0dc8abd9034743939e71cf2270e80d60",
      "statement": "Claude Code invokes the `statusLine` command once per session, piping its session JSON to the command's stdin and rendering the command's stdout as the status line; `claudebar render` honors this contract by reading all of stdin through the forgiving `InputData::parse` and writing the rendered line to stdout via `println!`, and `render_line` in `src/render/mod.rs` is the single rendering entrypoint shared by the hook, the TUI preview, and `smoke`.",
      "evidence": [
        {
          "resource": "repo://src/main.rs#L94-L108",
          "version": "repo-lines-v1:sha256:b38c3105b564657487b2989afc40aef34ba1268197bad6d34d221333de830527:"
