    {
      "id": "claim_c94fc1d6294f46abb343f50b6ae33840",
      "statement": "The cross-session limit sync store (src/segment/limit_sync.rs) records entries as atomic mkdir'd directories named <reset:%010d>_<pct:%07.3f> so lexical sort matches (reset, pct) ordering, keeps only the single highest entry per window, rejects implausibly-far-future resets, and swallows all filesystem errors so the cache is best-effort and never breaks rendering.",
      "evidence": [
        {
          "resource": "repo://src/segment/limit_sync.rs#L1-L140",
