  "claims": [
    {
      "id": "claim_2b42fb02c62248c390ef63aa4105e04d",
      "statement": "The Segment trait in src/segment/mod.rs is the extension seam for statusline units: render(&self, ctx: &RenderCtx, out: &mut SegmentWriter) -> bool writes a segment's body into the writer and returns true iff anything was emitted; an empty/absent segment returns false and the composer skips its separator.",
      "evidence": [
        {
          "resource": "repo://src/segment/mod.rs#L46-L52",
          "version": "repo-lines-v1:sha256:f1f13d54bf0e2a290a2b281d00d9c2c7512b025ee749b0bb953ea4167f8c131a:"
        }
      ]
    },
    {
      "id": "claim_6dccaaa662024b189b2874e1dea83d20",
      "statement": "Segments never know their neighbors, never emit a separator, and never embed a raw ANSI/color code; they read theme and style through the writer.",
      "evidence": [
        {
          "resource": "repo://src/segment/mod.rs#L1-L6",
          "version": "repo-lines-v1:sha256:80d80935c4a99d3a5e38dc9ea82bfc66c9e6e89f882031a94b26bec550983a8f:"
        }
      ]
    },
    {
      "id": "claim_992a03d5ce134a24b0ec0be7584c885c",
      "statement": "RenderCtx injects now (epoch seconds), home, tz_offset_seconds, and update rather than letting segments read the ambient environment, so rendering is deterministic and testable; the clock reads locale only through these injected values and cached detection, never a subprocess.",
