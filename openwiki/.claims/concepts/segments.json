    {
      "id": "claim_24678acb80204ff2b862307684e5fdc5",
      "statement": "Config::default uses SegmentKind::DEFAULT with Tokyo Night and Powerline, and the default_matches_bash_layout test locks the theme, style, segment order, and warn/crit thresholds to preserve bash parity.",
