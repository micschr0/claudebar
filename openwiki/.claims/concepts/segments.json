        }
      ]
    },
    {
      "id": "claim_9e2c5ffb41f44745b38bbded80f7319f",
      "statement": "SegmentKind (a 12-variant enum, serde kebab-case) encodes both which segments are enabled (presence in Config.segments) and their render order; SegmentKind::ALL is the canonical 12-segment order and SegmentKind::DEFAULT is the 8-segment default that mirrors the bash statusline's order (Lines placed between Context and RateLimits).",
      "evidence": [
        {
          "resource": "repo://src/model/config.rs#L14-L59",
          "version": "repo-lines-v1:sha256:b8e634b0d019c71dc4c59dea42ecff7323fdee47a9bc9c3f02135f3f482db132:"
        }
      ]
