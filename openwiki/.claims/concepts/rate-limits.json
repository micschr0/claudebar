    },
    {
      "id": "claim_18e43c1fb86e42b38fbb76e60c61aefd",
      "statement": "The 5-hour bar color follows the warn/crit thresholds (defaults warn:50, crit:80): pct >= crit -> bar_crit, pct >= warn -> bar_warn, otherwise bar_ok; the weekly bar is bar_crit at/above crit and otherwise bar_warn, with no ok state because the weekly gauge only appears once past the show threshold.",
      "evidence": [
        {
          "resource": "repo://src/model/config.rs#L90-L96",
          "version": "repo-lines-v1:sha256:de91afd750984e0636bda0101a44ca1bd679a7b8cd546335d17dae7a75e8c6a2:"
        },
        {
