  "claims": [
    {
      "id": "claim_6b277f077bd746b3911c9a709d64d376",
      "statement": "claudebar treats ANSI/OSC escape-injection as a terminal-injection surface: host-provided strings (cwd, git branch, model display name) are stripped of the terminal-control bytes ESC, BEL, CR, and LF before they enter the rendered statusline, in both the Rust render path and the bash fallback.",
      "evidence": [
        {
          "resource": "repo://src/sanitize.rs#L4-L12",
          "version": "repo-lines-v1:sha256:5c355e67f2fcbe7f55e33afd6a40012bf43d59eef35a963a203ee25ce3c5d11e:"
        },
        {
          "resource": "repo://statusline-command.sh#L16-L18",
          "version": "repo-lines-v1:sha256:0d861d47543b6a19ac24b11476588e573be63b6a228bc66f7b32d897b19656f5:"
        }
      ]
    },
    {
      "id": "claim_bcdfbd0bdcfd4ed5b5410d2f9f92276f",
      "statement": "sanitize::strip_control is a pure string transform that filters out exactly the four bytes ESC (\\x1b), BEL (\\x07), CR (\\r), and LF (\\n); it filters per Rust char so it is safe on multi-byte UTF-8 and never splits a codepoint.",
      "evidence": [
        {
          "resource": "repo://src/sanitize.rs#L7-L12",
          "version": "repo-lines-v1:sha256:9546505994a2169b1858dccd165449aca817c91cbb42c2368cb815e09b0e9c63:"
        }
      ]
    },
    {
      "id": "claim_79697c9420fe41f4bec40e40b53c4881",
      "statement": "Sanitization happens at render time per segment, not at parse time: InputData::parse is a plain serde_json deserialize with no sanitization, so raw host strings flow through the parsed model unmodified and are only made safe when a segment calls strip_control on the value it is about to emit.",
      "evidence": [
        {
          "resource": "repo://src/model/input.rs#L147-L153",
          "version": "repo-lines-v1:sha256:42531db528c65bd535237aeaf632a6767ba78c12f1d0c6c610ef03114205fdba:"
        }
      ]
    },
    {
