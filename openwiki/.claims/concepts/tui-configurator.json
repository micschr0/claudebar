    {
      "id": "claim_b928b98f44cf41c8b5751fe4dc33f2b0",
      "statement": "tui::run loads the config via Config::load_or_default (so a missing or malformed file becomes the default config and can never block the editor from opening), computes the effective save path from the explicit path or Config::default_path(), builds the App, enters the terminal via TerminalGuard, runs the event loop, and always drops the guard before returning.",
      "evidence": [
        {
          "resource": "repo://src/tui/mod.rs#L55-L70",
          "version": "repo-lines-v1:sha256:222492ddbc0deaa5d900fb97e32dd413348dd5c4118986528b304e22e49a92ac:"
        }
